# Copy this file to ".env" (git-ignored) before running the server.
# Django loads ".env" from the project root via python-dotenv.

# Maximum number of API requests processed at the same time by one server
# process. Requests above the limit are rejected with HTTP 503.
MAX_CONCURRENT_CLIENTS=20

# Test client ("client test/client.py") reads normal environment variables,
# not this file. Set them in your shell when the server is not on 127.0.0.1.
# BANK_SERVER_HOST=127.0.0.1
# BANK_SERVER_PORT=8000
# BANK_TEST_ACCOUNT=A1001

# Copy this file to ".env" (git-ignored) if you do not already have one.
# Docker Compose reads ".env" for variable interpolation, and the API
# containers receive the same values through "env_file".
#
# These are simulated credentials for a course project. Never put real
# banking or production secrets here.

# --- PostgreSQL --------------------------------------------------------------
DB_NAME=banking_db
DB_USER=banker
DB_PASSWORD=1234
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Django ------------------------------------------------------------------
# Comma-separated hostnames/IPs accepted in the Host header. The gateway
# proxies with the replica's Docker service name as the Host, so every API
# service name must be listed here.
ALLOWED_HOSTS=localhost,127.0.0.1,api,api-a1,api-a2,api-b1,api-b2,gateway
# Keep True for the Docker demo. Static assets are served by WhiteNoise, so
# the DRF browsable API and admin do not depend on debug mode.
DEBUG=True
# Simulated development key. Replace before any real deployment.
SECRET_KEY=django-insecure-d+112hg!+%u2t2a)3br0srg%dq9-o3fz&pgbnk_3(z4_g1b*2&

# --- Process identity --------------------------------------------------------
# Local (non-Docker) defaults. Docker Compose overrides DB_HOST, DB_NAME,
# SHARD_ID and REPLICA_ID per service. The local database holds A1001-A1005,
# which belong to shard-b.
SHARD_ID=shard-b
REPLICA_ID=local-1

# --- Admission control -------------------------------------------------------
# Maximum number of API requests processed at the same time by one server
# process. Each replica enforces its own limit, so with two replicas per shard
# the effective capacity of that shard doubles.
MAX_CONCURRENT_CLIENTS=20

# --- Participant prepare timeouts -------------------------------------------
# A prepare that cannot lock its account row within the lock timeout votes NO
# instead of waiting indefinitely. The statement timeout bounds the whole
# prepare and must stay below the coordinator RPC timeout.
PREPARE_LOCK_TIMEOUT_MS=4000
PREPARE_STATEMENT_TIMEOUT_MS=5000

# --- Coordinator -------------------------------------------------------------
# Durable 2PC state lives in its own database, not in a shard database. The
# coordinator reuses DB_USER/DB_PASSWORD; only the name and host differ.
COORD_DB_NAME=banking_coord
COORD_DB_HOST=127.0.0.1
COORD_DB_PORT=5432
COORD_RPC_TIMEOUT_SECONDS=6
COORD_RPC_ATTEMPTS=2
COORD_RECOVERY_INTERVAL_SECONDS=5
COORD_PREPARING_GRACE_SECONDS=12
# Test-only fault injection for Experiments 6 and Scenario B. Keep both at 0
# for normal operation; the demo overrides them through the shell.
COORD_TEST_PAUSE_AFTER_PREPARE_SECONDS=0
COORD_TEST_PAUSE_AFTER_DECISION_SECONDS=0

# --- Test client -------------------------------------------------------------
# Normal environment variables for "client test/client.py" (not read by Django).
BANK_SERVER_HOST=127.0.0.1
BANK_SERVER_PORT=8000
BANK_TEST_ACCOUNT=A1001

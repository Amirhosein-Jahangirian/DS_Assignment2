# Copy this file to ".env" (git-ignored) if you do not already have one.
# Docker Compose reads ".env" for variable interpolation, and the API
# containers receive the same values through "env_file".
#
# These are simulated credentials for a course project. Never put real
# banking or production secrets here.

# --- PostgreSQL --------------------------------------------------------------
DB_NAME=banking_db
DB_USER=banker
DB_PASSWORD=1234
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Django ------------------------------------------------------------------
# Comma-separated hostnames/IPs accepted in the Host header.
ALLOWED_HOSTS=localhost,127.0.0.1,api

# --- Admission control -------------------------------------------------------
# Maximum number of API requests processed at the same time by one server
# process. Requests above the limit are rejected with HTTP 503.
MAX_CONCURRENT_CLIENTS=20

# --- Test client -------------------------------------------------------------
# Normal environment variables for "client test/client.py" (not read by Django).
BANK_SERVER_HOST=127.0.0.1
BANK_SERVER_PORT=8000
BANK_TEST_ACCOUNT=A1001
